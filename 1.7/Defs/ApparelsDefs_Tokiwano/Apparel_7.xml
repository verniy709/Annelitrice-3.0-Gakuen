		<description>Dyeable.</description>
		<label>(Tokiwano)7_SchoolBag</label>
		<graphicData>
			<texPath>7/Anneli_Tokiwano_SchoolBag</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>7/Anneli_Tokiwano_SchoolBag</wornGraphicPath>
			<tags>
				<li>Anneli_Tokiwano_Kitakubuinn_WesternSuit</li>
				<li>Anneli_Tokiwano_Sabagebuin_WesternSuit</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(110,65,60,255)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(50,45,50,255)</only>
				</li>
			</options>
		</colorGenerator>
		<generateAllowChance>0.5</generateAllowChance><!--Less Spawn-->
	</ThingDef>

