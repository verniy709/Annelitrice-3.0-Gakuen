			<texPath>6ABC/Anneli_Tokiwano_KendoHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>6ABC/Anneli_Tokiwano_KendoHelmet</wornGraphicPath>
			<tags>
				<li>Anneli_Tokiwano_Kendobuin</li>
				<li>Anneli_SkipOverhead</li>
