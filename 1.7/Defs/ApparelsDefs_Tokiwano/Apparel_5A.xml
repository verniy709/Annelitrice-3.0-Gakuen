<!--Anneli_Tokiwano_ChestRig-->
	<ThingDef ParentName="Anneli_Tokiwano_5A">
		<defName>Anneli_Tokiwano_ChestRig</defName>
		<description>Dyeable.</description>
		<label>(Tokiwano)5A_ChestRig</label>
		<graphicData>
			<texPath>5A/Anneli_Tokiwano_ChestRig</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>5A/Anneli_Tokiwano_ChestRig</wornGraphicPath>
			<tags>
				<li>Anneli_Tokiwano_Kitakubuinn_WesternSuit</li>
				<li>Anneli_Tokiwano_SukebanA</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(50,45,50,255)</only>
				</li>
			</options>
		</colorGenerator>
		<generateAllowChance>0.7</generateAllowChance><!--Less Spawn-->
	</ThingDef>

