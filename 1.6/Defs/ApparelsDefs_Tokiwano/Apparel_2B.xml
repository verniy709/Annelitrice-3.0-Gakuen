	<!--Anneli_Tokiwano_Miniskirt-->
	<ThingDef ParentName="Anneli_Tokiwano_2B">
		<defName>Anneli_Tokiwano_Miniskirt</defName>
		<description>Dyeable.</description>
		<label>(Tokiwano)2B_Miniskirt</label>
		<graphicData>
			<texPath>2B/Anneli_Tokiwano_Miniskirt</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>2B/Anneli_Tokiwano_Miniskirt</wornGraphicPath>
			<tags>
				<li>Anneli_Tokiwano_SukebanB</li>
				<li>Anneli_Tokiwano_OuenbuinB</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(50,45,50,255)</only>
				</li>
			</options>
		</colorGenerator>
	</ThingDef>

