		<description>Dyeable. Collar.</description>
		<label>(Tokiwano)2A_SailorSuitA</label>
		<graphicData>
			<texPath>2A/Anneli_Tokiwano_SailorSuitA</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>2A/Anneli_Tokiwano_SailorSuitA</wornGraphicPath>
			<tags>
				<li>Anneli_Tokiwano_Kitakubuinn_SailorSuit</li>
				<li>Anneli_Tokiwano_Sabagebuin_SailorSuit</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
