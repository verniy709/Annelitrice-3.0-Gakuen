			<texPath>2C/Anneli_Tokiwano_Boots</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>2C/Anneli_Tokiwano_Boots</wornGraphicPath>
			<tags>
				<li>Anneli_Tokiwano_Kitakubuinn_WesternSuit</li>
				<li>Anneli_Tokiwano_Sabagebuin_WesternSuit</li>
				<li>Anneli_Tokiwano_Tsuppari</li>
				<li>Anneli_Tokiwano_SukebanA</li>
				<li>Anneli_Tokiwano_SukebanB</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>30</weight>
					<only>(50,45,50,255)</only>
				</li>
			</options>
		</colorGenerator>
	</ThingDef>

