		<defName>Anneli_Tokiwano_EyePatchA</defName>
		<description>Dyeable.</description>
		<label>(Tokiwano)6B_EyePatchA</label>
		<graphicData>
			<texPath>6B/Anneli_Tokiwano_EyePatchA</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>6B/Anneli_Tokiwano_EyePatchA</wornGraphicPath>
			<tags>
				<li>Anneli_Tokiwano_Kitakubuinn_WesternSuit</li>
				<li>Anneli_Tokiwano_Sabagebuin_WesternSuit</li>
				<li>Anneli_Tokiwano_Tsuppari</li>
				<li>Anneli_Tokiwano_SukebanA</li>
				<li>Anneli_Tokiwano_SukebanB</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(255,245,245,255)</only>
				</li>
			</options>
		</colorGenerator>
		<generateAllowChance>0.3</generateAllowChance><!--Less Spawn-->
	</ThingDef>

